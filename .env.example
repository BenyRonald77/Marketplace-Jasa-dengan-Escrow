DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Berapa hari setelah DELIVERED, order otomatis COMPLETED bila buyer tidak merespons
AUTO_RELEASE_DAYS=3

# Token rahasia untuk memicu endpoint auto-release dari scheduler eksternal
CRON_SECRET="ganti-dengan-token-acak"
